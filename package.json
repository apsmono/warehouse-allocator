{
  "name": "warehouse-allocator",
  "version": "0.3.0",
  "private": true,
  "description": "Medical-supply warehouse order allocation engine",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file=.env db/migrate.ts",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run test/db",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^3.23.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.4.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
